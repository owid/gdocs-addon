{
	"name": "owid-gdocs-addon",
	"private": true,
	"type": "module",
	"scripts": {
		"sidebarDev": "vite",
		"sidebarPreview": "vite preview",
		"manifestBuild": "node scripts/copy-manifest.mjs",
		"manifestBuild:watch": "node scripts/copy-manifest.mjs --watch",
		"sidebarBuild": "vite build --emptyOutDir",
		"sidebarBuild:watch": "npm run sidebarBuild -- --watch",
		"serverBuild": "rm -rf dist/server && tsc -p server",
		"serverBuild:watch": "tsc -p server --watch",
		"build": "npm run manifestBuild && npm run sidebarBuild && npm run serverBuild",
		"push": "npm run build && npx clasp push",
		"dev": "npm run build && npx tmex gdocs-addon \"npm run manifestBuild:watch\" \"npm run sidebarBuild:watch\" \"npm run serverBuild:watch\" \"npx clasp push --watch\""
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/material": "^9.5.0",
		"preact": "^11.2.0"
	},
	"prettier": {
		"semi": false
	},
	"devDependencies": {
		"@google/clasp": "^3.4.1",
		"@preact/preset-vite": "^2.10.6",
		"@types/google-apps-script": "^2.0.15",
		"@types/google.script.client-side": "^0.1.5",
		"eslint": "^9.39.5",
		"eslint-config-preact": "^2.0.0",
		"tmex": "^2.0.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-singlefile": "^2.3.4"
	}
}
